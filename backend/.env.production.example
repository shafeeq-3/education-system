# Production Environment Variables for Vercel Deployment
# Copy these to your Vercel Project Settings -> Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Database - MongoDB Atlas
# Get this from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration - Generate strong secrets
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_strong_jwt_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_super_strong_refresh_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Session Configuration
SESSION_SECRET=your_super_strong_session_secret_key_minimum_32_characters
SESSION_TIMEOUT=30

# Cloudinary (Optional - for file uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL - Your deployed frontend URL
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Rate Limiting
RATE_LIMIT_AUTH=5
RATE_LIMIT_GENERAL=100
RATE_LIMIT_UPLOAD=10

# File Upload (10MB in bytes)
MAX_FILE_SIZE=10485760

# Backup Schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Academic Configuration
ELIGIBILITY_THRESHOLD=75

# Important Notes:
# 1. Never commit this file with real values
# 2. Add all these variables in Vercel Dashboard
# 3. MongoDB Atlas: Whitelist Vercel IPs (0.0.0.0/0 for all)
# 4. Generate strong secrets using crypto.randomBytes()
# 5. Update FRONTEND_URL after deploying frontend
